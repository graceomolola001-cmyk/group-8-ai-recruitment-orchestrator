        },
        "filterByFormula": "AND({Interview Status}='PENDING', {Scheduled Start} != BLANK(), {Scheduled End} != BLANK(), {Candidate} != BLANK(), {Interviewer Email} != BLANK(), {Calendar Event ID} = BLANK(), IS_AFTER({Scheduled Start}, NOW()))",

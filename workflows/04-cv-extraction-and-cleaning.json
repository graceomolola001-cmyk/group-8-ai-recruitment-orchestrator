      "id": "fbcbed3f-fa99-4541-a369-7d1e197f531a",
      "name": "Extract Candidates CV"
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.item;\n\n// Get the text produced by Extract From File\nconst rawText = item.json.text || \"\";\n\n// Clean and normalize the extracted text\nconst cleanedText = rawText\n  .replace(/\\r\\n/g, \"\\n\")\n  .replace(/\\r/g, \"\\n\")\n  .replace(/[ \\t]+/g, \" \")\n  .replace(/^[ \\t]+|[ \\t]+$/gm, \"\")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\n// Check whether meaningful text was extracted\nconst extractionStatus =\n  cleanedText.length > 50 ? \"success\" : \"failed\";\n\n// Return the original data plus our cleaned text\nreturn {\n  json: {\n    ...item.json,\n    resumeText: cleanedText,\n    extractionStatus: extractionStatus,\n    extractionMessage:\n      extractionStatus === \"success\"\n        ? \"CV text extracted successfully\"\n        : \"CV text is empty or too short\"\n  },\n  binary: item.binary\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -352
      ],
      "id": "3ab4edce-955e-4115-b950-8a2939935fba",

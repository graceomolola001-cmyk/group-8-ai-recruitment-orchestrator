      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json.body ?? $json;\n\nconst candidateId = String(data.candidateId ?? \"\").trim();\nconst questions = data.questions;\n\nif (!candidateId) {\n  throw new Error(\"Missing candidateId\");\n}\n\nif (!Array.isArray(questions) || questions.length === 0) {\n  throw new Error(\"No valid screening questions received\");\n}\n\nfor (const q of questions) {\n  if (!q.id || !q.question || !q.competency) {\n    throw new Error(\"Incomplete screening question\");\n  }\n}\n\nreturn {\n  json: {\n    candidateId,\n    questions,\n    screeningQuestionsJson: JSON.stringify(questions),\n    questionCount: questions.length,\n    screeningStatus: \"QUESTIONS_GENERATED\"\n  }\n};\n"
      },

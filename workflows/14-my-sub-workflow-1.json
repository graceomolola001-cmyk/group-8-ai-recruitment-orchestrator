        "jsCode": "\n/*\n SUB-01: TEST SUB-WORKFLOW INPUT\n Mode: Run Once for Each Item\n*/\n\nconst request = $json;\n\nconst requiredFields = [\n  \"candidateId\",\n  \"candidateRecordId\",\n  \"requestedState\"\n];\n\nconst missingFields = requiredFields.filter(\n  field =>\n    request[field] === undefined ||\n    request[field] === null ||\n    String(request[field]).trim() === \"\"\n);\n\nif (missingFields.length > 0) {\n  throw new Error(\n    \"SUB-01 is missing required inputs: \" +\n    missingFields.join(\", \") +\n    \". Execute SUB-01 through the parent workflow.\"\n  );\n}\n\nreturn {\n  json: {\n    ...request,\n    subWorkflowReceived: true,\n    subWorkflowStatus: \"INPUT_OK\"\n  }\n};\n"
      },

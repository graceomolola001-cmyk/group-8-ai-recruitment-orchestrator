    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\n\nconst candidateId = String(\n  data.candidateId ?? data[\"Candidate ID\"] ?? \"\"\n).trim();\n\nif (!candidateId) {\n  throw new Error(\"Candidate ID is missing\");\n}\n\nconst answers = [];\n\nfor (let i = 1; i <= 8; i++) {\n  const questionId = `Q${i}`;\n  const answer = String(data[questionId] ?? \"\").trim();\n\n  if (!answer) {\n    throw new Error(\n      `Missing ${questionId} answer for ${candidateId}`\n    );\n  }\n\n  answers.push({\n    questionId,\n    answer\n  });\n}\n\nreturn {\n  json: {\n    candidateId,\n    candidateName: data.candidateName ?? \"\",\n    jobId: data.jobId ?? \"JOB-001\",\n    answers,\n    answersJson: JSON.stringify(answers),\n    answerCount: answers.length,\n    screeningStatus: \"ANSWERS_SUBMITTED\",\n    isSynthetic: data.isSynthetic === true,\n    submittedAt: data.submittedAt ?? new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
